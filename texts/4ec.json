%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-17.png\" rel=\"noopener nofollow\" target=\"_blank\"><img src=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-17.png\" alt=\"\" loading=\"lazy\"></a></p> <p>তিনি আগস্টের পরে তাসনিম জারার অবস্থান দিয়ে তার জুলাই জাস্টিফাই করেন! ভাবা যায়! তবে এইটা জাস্ট স্কিল ইস্যু ধরে এড়িয়ে যেতে পারেন।</p> <p><a href=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-16.png\" rel=\"noopener nofollow\" target=\"_blank\"><img src=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-16.png\" alt=\"\" loading=\"lazy\"></a></p> <p>মাওলানা মা’মুনুল হকের দ্বিতীয় স্ত্রীর বিষয়টি নিয়ে আওয়ামী লীগের ছড়ানো প্রোপ্যাগান্ডা গিলে তিনি মাওলানা মা’মুনুল হকের বিয়েকে “লীভ টুগেদার” হিসাবে প্রচার করছেন! “নারী শোষণ” হিসাবে প্রচার করছেন! [<a href=\"https://ghostarchive.org/archive/cBRf1\" rel=\"noopener nofollow\" target=\"_blank\">আর্কাইভকৃত</a>]</p><p><a href=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-15.png\" rel=\"noopener nofollow\" target=\"_blank\"><img src=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-15.png\" alt=\"\" loading=\"lazy\"></a></p> <p>মাওলানা মামুনুল হক তাঁর স্ত্রীর সাথে বিয়ের ব্যাপারে সত্য বললেও, সেটাকে মক করে দিলশানা পারুল অবৈধ সম্পর্ক বলে প্রচার করেছেন! [<a href=\"https://ghostarchive.org/archive/G7T0R\" rel=\"noopener nofollow\" target=\"_blank\">আর্কাইভকৃত</a>]</p><p><a href=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-14.png\" rel=\"noopener nofollow\" target=\"_blank\"><img src=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-14.png\" alt=\"\" loading=\"lazy\"></a></p> <p>যদিও তাদের এই অভিযোগ মিথ্যা প্রমাণিতই হয়েছে শেষ পর্যন্ত।<sup>[1]</sup></p> <p>তিনি ভবিষ্যতে মুসলিমবঙ্গের মুসলিমদের জন্য কতটুকু সেইফ হবেন সেটা তার নিচের কথাবার্তা থেকে বোঝা যায়ঃ [<a href=\"https://ghostarchive.org/archive/pkrvy\" rel=\"noopener nofollow\" target=\"_blank\">আর্কাইভকৃত</a>]</p><blockquote><p>“আমরা যখন শ্লোগান দিতাম তখন একসাথে বলতাম</p> <p>মৌলবাদ নিপাত যাক !</p> <p>স্যেকুলারিজম মুক্তিপাক</p> <p>স্বৈরতন্ত্র নিপাত যাক , গনতন্ত্র মুক্তিপাক !”Dilshara Parul</p></blockquote> <p><a href=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-13.png\" rel=\"noopener nofollow\" target=\"_blank\"><img src=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-13.png\" alt=\"\" loading=\"lazy\"></a></p> <p>ফ্যাসিবাদের প্রথম আলো বন্ধের কথাতে তার গা জ্বলে যায়! অথচ প্রথম আলো গং দের অপসাংবাদিকতা তিনি অস্বীকারও করেন না! হাহা! [<a href=\"https://ghostarchive.org/archive/WyadQ\" rel=\"noopener nofollow\" target=\"_blank\">আর্কাইভকৃত</a>]</p><p><a href=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-12.png\" rel=\"noopener nofollow\" target=\"_blank\"><img src=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-12.png\" alt=\"\" loading=\"lazy\"></a></p> <p>ধর্মকর্ম তিনি মানেন না ঠিকই, তবে আবার মাহফুজদের লালনবাদ কে ইসলাম হিসেবে প্রোমোট করতেও ভোলেন না! লালনবাদ ও খিলাফাহ (হিজবুত তাহরীর নাম দিয়ে) এর বাইনারিতে তিনি লালনবাদকে ইসলাম হিসাবে উপস্থাপন করেন।</p> <p><a href=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-%E0%A6%AF%E0%A7%81%E0%A6%97%E0%A7%8D%E0%A6%AE-%E0%A6%AE%E0%A7%81%E0%A6%96%E0%A7%8D%E0%A6%AF-%E0%A6%B8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%AC%E0%A7%9F%E0%A6%95-%E0%A6%A6%E0%A6%BF%E0%A6%B2%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A6%BE-%E0%A6%AA%E0%A6%BE%E0%A6%B0%E0%A7%81%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%87%E0%A6%B8%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AC%E0%A7%87%E0%A6%B7-%E0%A6%93-%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A6%AC%E0%A6%BE%E0%A6%97%E0%A7%80%E0%A6%AA%E0%A6%A8%E0%A6%BE-11.png\" rel=\"noopener nofollow\" target=\"_blank\"><img src=\"https://www.frommuslims.com/wp-content/uploads/2025/03/%E0%A6%8F%E0%A6%A8%E0%A6%B8%E0%A6%BF%E0%A6%AA%E0%A6%BF-